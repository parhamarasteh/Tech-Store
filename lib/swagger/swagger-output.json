        }
      },
      "delete": {
        "tags": ["Media"],
        "summary": "حذف رسانه",
        "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d4" }
          }
        ],
        "responses": {
          "200": {
            "description": "رسانه با موفقیت حذف شد",
            "content": {
              "application/json": {
