                    "mediaId": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "عدم دسترسی", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "رسانه وجود ندارد", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "شناسه نامعتبر", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/product": {
      "get": {
        "tags": ["Products"],
        "summary": "دریافت لیست تمام محصولات با جزئیات",
        "responses": {
          "200": {
            "description": "لیست کامل محصولات به همراه اطلاعات رسانه، دسته‌بندی و برند",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Product" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Products"],
        "summary": "ایجاد محصول جدید",
        "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AddProductRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "محصول با موفقیت ایجاد شد",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "محصول با موفقیت ایجاد شد" },
                    "_id": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d5" },
                    "name": { "type": "string", "example": "گوشی موبایل گلکسی S24" }
                  }
                }
              }
            }
          },
          "401": { "description": "عدم دسترسی", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "اطلاعات ارسالی یا شناسه‌های ارجاع داده شده نامعتبر هستند", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } } }
        }
      }
    },
    "/api/product/sale": {
      "get": {
        "tags": ["Products"],
        "summary": "دریافت محصولات دارای تخفیف",
        "description": "دریافت کلیه محصولاتی که درصد تخفیف (sale) آنها بزرگتر از صفر است",
        "responses": {
          "200": {
            "description": "لیست محصولات تخفیف‌دار",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Product" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/product/category/{categoryName}": {
      "get": {
        "tags": ["Products"],
        "summary": "دریافت محصولات یک دسته‌بندی بر اساس نام انگلیسی",
        "parameters": [
          {
            "name": "categoryName",
            "in": "path",
            "required": true,
            "description": "نام انگلیسی دسته‌بندی (مانند mobile)",
            "schema": { "type": "string", "example": "mobile" }
          }
        ],
        "responses": {
          "200": {
            "description": "اطلاعات دسته‌بندی به همراه لیست محصولات آن",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "_id": { "type": "string" },
                        "name": { "type": "string" },
                        "en_name": { "type": "string" },
                        "image": { "type": "string" },
                        "products": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Product" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "دسته‌بندی مورد نظر یافت نشد", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/product/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "دریافت اطلاعات یک محصول با شناسه",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d5" }
          }
        ],
        "responses": {
          "200": {
            "description": "اطلاعات محصول",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Product" }
                  }
                }
              }
            }
          },
          "404": { "description": "محصول یافت نشد", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "شناسه محصول نامعتبر است", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "put": {
        "tags": ["Products"],
        "summary": "به‌روزرسانی یک محصول",
        "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d5" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProductRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "محصول با موفقیت به‌روزرسانی شد",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "محصول با موفقیت به‌روزرسانی شد" },
                    "productId": { "type": "string" },
                    "product": { "$ref": "#/components/schemas/Product" }
                  }
                }
              }
            }
          },
          "401": { "description": "عدم دسترسی", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "محصول وجود ندارد", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "داده یا شناسه‌های ارجاع داده شده نامعتبر هستند", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } } }
        }
      },
      "delete": {
        "tags": ["Products"],
        "summary": "حذف یک محصول",
        "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d5" }
          }
        ],
        "responses": {
          "200": {
            "description": "محصول با موفقیت حذف شد",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "محصول با موفقیت حذف شد" },
                    "productId": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "عدم دسترسی", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "محصول وجود ندارد", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "شناسه محصول نامعتبر است", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "هدر استاندارد Authorization به صورت Bearer <token>"
      },
      "CookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token",
        "description": "کوکی نشست با کلید token"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "عملیات با موفقیت انجام شد" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "منبع مورد نظر یافت نشد" }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "اطلاعات ارسالی نامعتبر است" },
          "errors": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["نام باید حداقل ۳ کاراکتر باشد", "لطفاً یک آدرس ایمیل معتبر وارد کنید"]
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            },
            "example": {
              "name": ["نام باید حداقل ۳ کاراکتر باشد"],
              "email": ["لطفاً یک آدرس ایمیل معتبر وارد کنید"]
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d1" },
          "name": { "type": "string", "example": "علی رضایی" },
          "email": { "type": "string", "format": "email", "example": "ali@example.com" }
        }
      },
      "SignUpRequest": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 50, "example": "علی رضایی" },
          "email": { "type": "string", "format": "email", "example": "ali@example.com" },
          "password": { "type": "string", "minLength": 6, "maxLength": 100, "example": "StrongPass123" }
        }
      },
      "SignInRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "ali@example.com" },
          "password": { "type": "string", "minLength": 6, "maxLength": 100, "example": "StrongPass123" }
        }
      },
      "Brand": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d2" },
          "name": { "type": "string", "example": "سامسونگ" },
          "logo": { "type": "string", "format": "uri", "example": "https://example.com/samsung.png" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AddBrandRequest": {
        "type": "object",
        "required": ["name", "logo"],
        "properties": {
          "name": { "type": "string", "example": "سامسونگ" },
          "logo": { "type": "string", "format": "uri", "example": "https://example.com/samsung.png" }
        }
      },
      "UpdateBrandRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "سامسونگ" },
          "logo": { "type": "string", "format": "uri", "example": "https://example.com/samsung-new.png" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d3" },
          "name": { "type": "string", "example": "گوشی موبایل" },
          "en_name": { "type": "string", "example": "mobile" },
          "image": { "type": "string", "format": "uri", "example": "https://example.com/mobile.jpg" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AddCategoryRequest": {
        "type": "object",
        "required": ["name", "en_name", "image"],
        "properties": {
          "name": { "type": "string", "example": "گوشی موبایل" },
          "en_name": { "type": "string", "example": "mobile" },
          "image": { "type": "string", "format": "uri", "example": "https://example.com/mobile.jpg" }
        }
      },
      "UpdateCategoryRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "گوشی موبایل هوشمند" },
          "en_name": { "type": "string", "example": "smart-phones" },
          "image": { "type": "string", "format": "uri", "example": "https://example.com/mobile-new.jpg" }
        }
      },
      "Media": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d4" },
          "url": { "type": "string", "format": "uri", "example": "https://example.com/images/banner.jpg" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AddMediaRequest": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri", "example": "https://example.com/images/banner.jpg" }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d5" },
          "name": { "type": "string", "example": "گوشی موبایل گلکسی S24" },
          "price": { "type": "number", "example": 50000000 },
          "sale": { "type": "number", "example": 10 },
          "media": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Media" }
          },
          "category": { "$ref": "#/components/schemas/Category" },
          "brand": { "$ref": "#/components/schemas/Brand" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AddProductRequest": {
        "type": "object",
        "required": ["name", "price", "media", "category", "brand"],
        "properties": {
          "name": { "type": "string", "example": "گوشی موبایل گلکسی S24" },
          "price": { "type": "number", "minimum": 0, "example": 50000000 },
          "sale": { "type": "number", "minimum": 0, "maximum": 100, "default": 0, "example": 10 },
          "media": {
            "type": "array",
            "items": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d4" }
          },
          "category": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d3" },
          "brand": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d2" }
        }
      },
      "UpdateProductRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "گوشی موبایل گلکسی S24 اولترا" },
          "price": { "type": "number", "minimum": 0, "example": 60000000 },
          "sale": { "type": "number", "minimum": 0, "maximum": 100, "example": 15 },
          "media": {
            "type": "array",
            "items": { "type": "string" }
          },
          "category": { "type": "string" },
          "brand": { "type": "string" }
        }
      }
    }
  }
}