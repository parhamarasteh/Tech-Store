{
  "openapi": "3.0.3",
  "info": {
    "title": "Shop API",
    "description": "مستندات کامل و دقیق API فروشگاه بر پایه Express و MongoDB",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Development Server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "عملیات احراز هویت و مدیریت نشست کاربر"
    },
    {
      "name": "Brands",
      "description": "مدیریت برندها"
    },
    {
      "name": "Categories",
      "description": "مدیریت دسته‌بندی‌ها"
    },
    {
      "name": "Products",
      "description": "مدیریت و فیلتر محصولات"
    },
    {
      "name": "Media",
      "description": "مدیریت فایل‌ها و رسانه‌ها"
    }
  ],
  "paths": {
    "/api/auth/sign-up": {
      "post": {
        "tags": ["Auth"],
        "summary": "ثبت نام کاربر جدید",
        "description": "ایجاد حساب کاربری جدید با نام، ایمیل یکتا و رمز عبور امن",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "کاربر با موفقیت ایجاد شد",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "کاربر با موفقیت ساخته شد" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "409": {
            "description": "ایمیل قبلاً ثبت شده است",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "422": {
            "description": "داده‌های ارسالی نامعتبر است",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-in": {
      "post": {
        "tags": ["Auth"],
        "summary": "ورود به حساب کاربری",
        "description": "احراز هویت کاربر و تنظیم کوکی امن نشست و ارسال توکن",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ورود با موفقیت انجام شد",
            "headers": {
              "Set-Cookie": {
                "description": "کوکی توکن احراز هویت با فلگ‌های HttpOnly و Secure",
                "schema": {
                  "type": "string",
                  "example": "token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...; Path=/; HttpOnly; SameSite=Lax"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "ورود با موفقیت انجام شد" },
                    "token": { "type": "string" },
                    "authorized": { "type": "boolean", "example": true },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "ایمیل یا رمز عبور نادرست است",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "422": {
            "description": "فرمت ایمیل یا رمز نامعتبر است",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "delete": {
        "tags": ["Auth"],
        "summary": "خروج از حساب کاربری",
        "description": "حذف کوکی نشست کاربر",
        "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
        "responses": {
          "200": {
            "description": "نشست با موفقیت حذف شد",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
              }
            }
          },
          "401": {
            "description": "کاربر لاگین نکرده است",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "tags": ["Auth"],
        "summary": "بررسی وضعیت نشست فعلی",
        "description": "بررسی معتبر بودن توکن لاگین و دریافت شناسه کاربر",
        "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
        "responses": {
          "200": {
            "description": "نشست معتبر است",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "authorized": { "type": "boolean", "example": true },
                    "session": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d1" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "نشست نامعتبر است یا وجود ندارد",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/brand": {
      "get": {
        "tags": ["Brands"],
        "summary": "دریافت لیست تمام برندها",
        "responses": {
          "200": {
            "description": "لیست برندها",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Brand" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Brands"],
        "summary": "ایجاد برند جدید",
        "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AddBrandRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "برند با موفقیت ایجاد شد",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "برند با موفقیت ایجاد شد" },
                    "data": { "$ref": "#/components/schemas/Brand" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "عدم دسترسی احراز هویت",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "برندی با این نام قبلاً ثبت شده است",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "422": {
            "description": "اطلاعات ارسالی نامعتبر است",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/brand/{id}": {
      "get": {
        "tags": ["Brands"],
        "summary": "دریافت یک برند بر اساس شناسه",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "شناسه ۲۴ رقمی ObjectId برند",
            "schema": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d2" }
          }
        ],
        "responses": {
          "200": {
            "description": "اطلاعات برند",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Brand" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "برند مورد نظر یافت نشد",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "422": {
            "description": "شناسه ارسالی نامعتبر است",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Brands"],
        "summary": "به‌روزرسانی یک برند",
        "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "شناسه ۲۴ رقمی ObjectId برند",
            "schema": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d2" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateBrandRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "برند با موفقیت به‌روزرسانی شد",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "برند با موفقیت به‌روزرسانی شد" },
                    "brandId": { "type": "string" },
                    "brand": { "$ref": "#/components/schemas/Brand" }
                  }
                }
              }
            }
          },
          "401": { "description": "عدم دسترسی", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "برند وجود ندارد", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "داده نامعتبر", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } } }
        }
      },
      "delete": {
        "tags": ["Brands"],
        "summary": "حذف یک برند",
        "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d2" }
          }
        ],
        "responses": {
          "200": {
            "description": "برند با موفقیت حذف شد",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "برند با موفقیت حذف شد" },
                    "brandId": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "عدم دسترسی", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "برند وجود ندارد", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "شناسه نامعتبر", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/category": {
      "get": {
        "tags": ["Categories"],
        "summary": "دریافت لیست تمام دسته‌بندی‌ها",
        "responses": {
          "200": {
            "description": "لیست دسته‌بندی‌ها",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Category" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Categories"],
        "summary": "ایجاد دسته‌بندی جدید",
        "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AddCategoryRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "دسته‌بندی با موفقیت ایجاد شد",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "دسته‌بندی با موفقیت ایجاد شد" },
                    "data": { "$ref": "#/components/schemas/Category" }
                  }
                }
              }
            }
          },
          "401": { "description": "عدم دسترسی", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "409": { "description": "دسته‌بندی با این نام یا نام انگلیسی قبلاً ثبت شده است", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "اطلاعات ارسالی نامعتبر است", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } } }
        }
      }
    },
    "/api/category/{id}": {
      "get": {
        "tags": ["Categories"],
        "summary": "دریافت یک دسته‌بندی بر اساس شناسه",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d3" }
