                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Category" }
                  }
                }
              }
            }
          },
          "404": { "description": "دسته‌بندی مورد نظر یافت نشد", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "شناسه ارسالی نامعتبر است", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "put": {
        "tags": ["Categories"],
        "summary": "به‌روزرسانی دسته‌بندی",
        "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d3" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateCategoryRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "دسته‌بندی با موفقیت به‌روزرسانی شد",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "دسته‌بندی با موفقیت به‌روزرسانی شد" },
                    "categoryId": { "type": "string" },
                    "category": { "$ref": "#/components/schemas/Category" }
                  }
                }
              }
            }
          },
          "401": { "description": "عدم دسترسی", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "دسته‌بندی وجود ندارد", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "داده نامعتبر", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } } }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "summary": "حذف دسته‌بندی",
        "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "65f1a2b3c4d5e6f7a8b9c0d3" }
          }
        ],
        "responses": {
          "200": {
            "description": "دسته‌بندی با موفقیت حذف شد",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "دسته‌بندی با موفقیت حذف شد" },
                    "categoryId": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "عدم دسترسی", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "دسته‌بندی وجود ندارد", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "شناسه نامعتبر", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/media": {
      "get": {
        "tags": ["Media"],
        "summary": "دریافت لیست تمام فایل‌ها و رسانه‌ها",
